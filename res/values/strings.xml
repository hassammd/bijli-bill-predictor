    <!-- About -->
    <string name="about_title">About</string>
    <string name="about_subtitle">Bill Fetcher</string>
    <string name="about_how">How it works</string>
    <string name="about_step1">1. Get the reference number from your LESCO bill (as printed, with U/R)</string>
    <string name="about_step2">2. Enter in the app and tap VIEW BILL</string>
    <string name="about_step3">3. See your full bill in complete detail — no need to open the website</string>
    <string name="about_source_title">Where the data comes from</string>
    <string name="about_source_text">Bill data is fetched from the official LESCO / PITC website. Rates and taxes are printed on the bill itself — the app does not calculate anything; it simply shows your real bill.</string>
    <string name="about_disclaimer_title">Official Sources &amp; Disclaimer</string>
    <string name="about_disclaimer_text">Tariff slabs: NEPRA (nepra.org.pk). Bill records: official PITC billing portal used by Pakistani DISCOs — PITC operates under Pakistan\'s Ministry of Energy, Power Division (power.gov.pk). This is an independent app — NOT affiliated with, endorsed by, or representing NEPRA, WAPDA, PITC, or any DISCO (LESCO, IESCO, GEPCO, FESCO, MEPCO, etc.). Predictions are estimates for guidance only.</string>
    <string name="about_update_btn">CHECK FOR UPDATES</string>
    <string name="about_update_msg">Update check coming soon.</string>
