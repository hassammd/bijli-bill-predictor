<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hatch.bijlibill"
    android:versionCode="188"
    android:versionName="3.7.56">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="36" />

    <!-- needed to fetch bills from the LESCO/PITC portal -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- needed for the v2.0.5 internet pre-check before fetching -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- v2.3.0: due-date reminder notification (runtime request on
         Android 13+, once, with a plain-words rationale) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- v3.1.1: re-arm the daily bill reminder after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- v2.3.0: exact-alarm scheduling for the reminder (2 days before
         the due date, 09:00); falls back gracefully when unavailable -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- v2.3.0: saving the downloaded PDF to Downloads on Android 9
         and below only (API 29+ uses MediaStore, no permission needed) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- v3.7.56 (188): Google Mobile Ads SDK 23.6.0 — permissions
         merged manually from the play-services-ads-lite /
         play-services-measurement AAR manifests (no Gradle manifest
         merger in this manual build). AD_ID lets the SDK read the
         Advertising ID; the ADSERVICES permissions are for the
         Privacy Sandbox (Topics/attribution); WAKE_LOCK is declared
         by the measurement SDK. The ads-lite manifest's
         tools:node="remove" on RECEIVE_BOOT_COMPLETED is
         deliberately NOT copied — the app needs that permission
         for its reminder re-arm receiver. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- v3.7.56 (188): package-visibility queries from the ads-lite
         AAR manifest — ad click-throughs need to resolve the
         browser, Custom Tabs, calendar, SMS and dialer intents
         (Android 11+ package visibility rules). -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/event" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="sms" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:path="tel:" />
        </intent>
    </queries>

    <!-- v3.7.54: portrait lock is a UI choice, not a hardware
         requirement. The screenOrientation="portrait" on the
         activities below implies a REQUIRED portrait-screen
         hardware feature, which Play Console flagged as blocking
         the 185 submission (2026-11-24). Marking it optional
         keeps phones portrait while Play lists the app on devices
         without a portrait screen. The orientation attributes
         are untouched. -->
    <uses-feature android:name="android.hardware.screen.portrait"
        android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- AdMob App ID (TEST id — replace with your real AdMob App ID before release).
             Must match AdsConfig.ADMOB_APP_ID. -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-8117548332904163~2883931517" />

        <!-- v3.7.56 (188): Google Mobile Ads SDK 23.6.0 components,
             merged manually from the play-services-ads-lite AAR
             manifest (no Gradle manifest merger in this manual
             build). AdActivity is REQUIRED for interstitials;
             MobileAdsInitProvider auto-initializes the SDK at app
             start (AdsManager.init also calls MobileAds.initialize
             — the SDK ignores repeat calls); AdService plus the
             two handler activities are the SDK's own components.
             The ${applicationId} placeholder is written out
             literally here (aapt2 does not substitute it). -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent" />
        <provider
            android:name="com.google.android.gms.ads.MobileAdsInitProvider"
            android:authorities="com.hatch.bijlibill.mobileadsinitprovider"
            android:exported="false"
            android:initOrder="100" />
        <service
            android:name="com.google.android.gms.ads.AdService"
            android:enabled="true"
            android:exported="false" />
        <activity
            android:name="com.google.android.gms.ads.OutOfContextTestingActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:exported="false" />
        <activity
            android:name="com.google.android.gms.ads.NotificationHandlerActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <property
            android:name="android.adservices.AD_SERVICES_CONFIG"
            android:resource="@xml/gma_ad_services_config" />
        <uses-library
            android:name="android.ext.adservices"
            android:required="false" />
        <!-- v3.7.56 (188): Play Services version, from the
             play-services-basement AAR manifest. -->
        <meta-data
            android:name="com.google.android.gms.version"
            android:value="@integer/google_play_services_version" />

        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/AppTheme.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".BillActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- v3.6.9: full-screen bill viewer (new page, like competitor apps) -->
        <activity
            android:name=".BillViewerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- v2.6.0 design system: bottom-nav "Bills" tab — full saved-meter
             list (same tap/long-press behaviour as the home cards) -->
        <activity
            android:name=".BillsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- v3.7.43: Pending Bills list — opens from a tap on the
             Home "Total Payable" card (user order 2026-11-21) -->
        <activity
            android:name=".PendingBillsActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- v2.2.0 Meter Check: longer videos, kWh auto-detect, gallery
             upload (no new permissions — ACTION_GET_CONTENT grants
             one-shot read access to the picked video) -->
        <activity
            android:name=".MeterCheckActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- v3.2.0: 200-Unit Guard screen -->
        <activity
            android:name=".GuardActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- v3.2.0: What-if Compare screen -->
        <activity
            android:name=".WhatIfActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- v2.3.0: due-date reminder receiver (explicit broadcast from
             AlarmManager only — not exported) -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />

        <!-- v3.1.1: daily bill reminder (inexact repeating alarm,
             explicit broadcast only — not exported) -->
        <receiver
            android:name=".DailyReminderReceiver"
            android:exported="false" />

        <!-- v3.2.0: daily 200-Unit Guard check (inexact repeating
             alarm, explicit broadcast only — not exported) -->
        <receiver
            android:name=".GuardReminderReceiver"
            android:exported="false" />

        <!-- v3.4.0: one-shot bill-day nudge (explicit broadcast only
             — not exported) -->
        <receiver
            android:name=".BillDayNudgeReceiver"
            android:exported="false" />

        <!-- v3.4.0: weekly usage report (inexact repeating alarm,
             explicit broadcast only — not exported) -->
        <receiver
            android:name=".WeeklyReportReceiver"
            android:exported="false" />

        <!-- v3.1.1: re-arm the daily reminder after reboot -->
        <receiver
            android:name=".BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
